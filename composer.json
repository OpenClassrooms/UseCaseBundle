{
    "name": "openclassrooms/use-case-bundle",
    "description": "Symfony Bundle for OpenClassrooms UseCase",
    "type": "symfony-bundle",
    "keywords": ["design"],
    "license": "MIT",
    "authors": [
        {
            "name": "Romain Kuzniak",
            "email": "romain.kuzniak@turn-it-up.org"
        },
        {
            "name": "OpenClassrooms",
            "email": "tech@openclassrooms.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "OpenClassrooms\\Bundle\\UseCaseBundle\\": ""
        }
    },
    "require": {
        "php": ">=8.3",
        "openclassrooms/use-case": "^2.0 || ^3.0",
        "symfony/cache":  "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/security-core": "^6.4 || ^7.4",
        "doctrine/orm": "~2.3 || ~3.2",
        "doctrine/dbal": "~3.2",
        "symfony/event-dispatcher": "^6.4 || ^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    }
}
